# Copie para .env.local e preencha. Variáveis VITE_* ficam visíveis no navegador:
# use apenas a chave "anon" do Supabase (nunca a service_role) e URLs sem segredo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL base de um servidor OpenTripPlanner 2 (ex.: http://localhost:8080). Vazio = roteamento desativado.
VITE_ROUTING_API_BASE_URL=
# Reservada para um futuro backend de dados de transporte. Ainda NÃO é lida por nenhum código.
VITE_TRANSPORT_API_BASE_URL=

# Só no servidor (Netlify → Environment variables). NUNCA use prefixo VITE_ aqui.
# TRAVELPAYOUTS_TOKEN=
# TRAVELPAYOUTS_MARKER=
# TRAVELPAYOUTS_TRS=
# ANTHROPIC_API_KEY=            # assistente de roteiro; só no servidor
# SUPABASE_URL=                 # mesmo valor de VITE_SUPABASE_URL, para a função validar o login
# SUPABASE_ANON_KEY=            # mesmo valor de VITE_SUPABASE_ANON_KEY
# ROTEIRO_MODEL=claude-opus-5-5 # padrão; claude-sonnet-5-5 custa menos
# ROTEIRO_DAILY_LIMIT=5         # roteiros por usuário por dia (por instância; configure também o limite de gasto no Console)
